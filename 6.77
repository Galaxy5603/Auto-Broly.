-- SCRIPT / Auto Leech
repeat wait() until game:IsLoaded()
game.Players.LocalPlayer.PlayerGui:WaitForChild("HUD")


        local plr = game.Players.LocalPlayer
        plr.PlayerGui.HUD.Bottom:WaitForChild("Stats").Image = 'rbxassetid://6717696974' -- rbxassetid://11486610192 or rbxassetid://6717696974
if game.Players.LocalPlayer.PlayerGui:FindFirstChild("HUD") then wait(1)
